<Window x:Class="CameraReceiverKimi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Camera Receiver" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <!-- Изображение на весь экран -->
        <Image Source="{Binding CurrentImage}" 
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Полупрозрачная панель снизу -->
        <Border VerticalAlignment="Bottom" 
                Background="#CC000000" 
                Padding="20,10">
            <StackPanel>
                <!-- Комментарий -->
                <TextBlock Text="{Binding CommentText}" 
                           Foreground="White" 
                           FontSize="24"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Информация о подключении -->
                <TextBlock Text="{Binding ConnectionInfo}" 
                           Foreground="#AAAAAA" 
                           FontSize="14"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Индикатор запуска сервера -->
        <Border VerticalAlignment="Top" 
                HorizontalAlignment="Right"
                Background="#CC000000"
                Padding="15,8"
                Margin="10"
                CornerRadius="4"
                Visibility="{Binding IsServerRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="● Сервер активен" 
                       Foreground="#4CAF50" 
                       FontSize="14"/>
        </Border>
    </Grid>
</Window>
